{
  "name": "arc-agora-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3050",
    "build": "next build",
    "start": "next start",
    "check:circle": "circle --version && circle blockchain list",
    "check:arc": "arc-canteen --help",
    "check:hardhat": "hardhat --version",
    "check:sdk": "tsx scripts/check-sdk-imports.ts",
    "check:sentient": "powershell -ExecutionPolicy Bypass -File scripts/check-sentient.ps1",
    "check:opendeepsearch": "tsx scripts/check-opendeepsearch-config.ts",
    "check:opendeepsearch:runtime": "tsx scripts/check-opendeepsearch-runtime.ts",
    "check:sentient:pipeline": "tsx scripts/check-sentient-pipeline.ts",
    "check:primary-model": "tsx scripts/check-primary-model.ts",
    "primary-model:smoke": "tsx scripts/smoke-primary-model.ts",
    "check:agent-run": "tsx scripts/check-agent-run-record.ts",
    "check:demo": "tsx scripts/check-demo-preflight.ts",
    "check:readiness": "tsx scripts/check-product-readiness.ts",
    "check:safety": "tsx scripts/check-tool-safety.ts",
    "check:sources": "tsx scripts/check-source-registry-scoring.ts",
    "check:studio": "tsx scripts/check-market-studio.ts",
    "submission:pack": "tsx scripts/generate-submission-pack.ts",
    "sources:seed": "tsx scripts/seed-source-registry.ts",
    "sources:add": "tsx scripts/add-source-registry-record.ts",
    "arc:verify-rpc": "tsx scripts/verify-arc-rpc.ts",
    "arc:prepare-receipt": "tsx scripts/prepare-analysis-receipt.ts",
    "arc:prepare-integrity-receipt": "tsx scripts/prepare-integrity-receipt.ts",
    "arc:prepare-intent-receipt": "tsx scripts/prepare-intent-receipt.ts",
    "arc:estimate-intent-receipt": "tsx scripts/estimate-intent-receipt.ts",
    "arc:deploy-receipt": "tsx scripts/deploy-analysis-receipt.ts",
    "arc:read-receipt": "tsx scripts/read-analysis-receipt.ts",
    "arc:record-integrity-receipt": "tsx scripts/record-integrity-receipt.ts",
    "arc:record-intent-receipt": "tsx scripts/record-intent-receipt.ts",
    "arc:record-intent-receipt:local": "tsx scripts/record-intent-receipt-local.ts",
    "x402:inspect": "powershell -ExecutionPolicy Bypass -File scripts/x402-market-data.ps1 -Mode inspect",
    "x402:estimate": "powershell -ExecutionPolicy Bypass -File scripts/x402-market-data.ps1 -Mode estimate",
    "x402:pay:markets": "powershell -ExecutionPolicy Bypass -File scripts/x402-market-data.ps1 -Mode pay -MaxAmount 0.001 -OutFile .cache/x402/latest-polymarket-markets.json",
    "x402:pay:trades": "powershell -ExecutionPolicy Bypass -File scripts/x402-market-data.ps1 -Mode pay -Url https://nano.blockrun.ai/api/v1/pm/polymarket/trades -MaxAmount 0.001 -OutFile .cache/x402/latest-polymarket-trades.json",
    "x402:research:inspect": "tsx scripts/x402-research.ts --mode inspect",
    "x402:research:estimate": "tsx scripts/x402-research.ts --mode estimate",
    "x402:research:pay": "tsx scripts/x402-research.ts --mode pay",
    "contracts:compile": "hardhat compile",
    "services:crypto": "circle services search crypto --limit 10",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@circle-fin/adapter-circle-wallets": "^1.3.0",
    "@circle-fin/adapter-ethers-v6": "^1.8.0",
    "@circle-fin/adapter-solana-kit": "^1.4.9",
    "@circle-fin/adapter-viem-v2": "latest",
    "@circle-fin/app-kit": "latest",
    "@circle-fin/bridge-kit": "latest",
    "@circle-fin/cli": "^0.0.3",
    "@circle-fin/developer-controlled-wallets": "latest",
    "@circle-fin/modular-wallets-core": "^1.0.13",
    "@circle-fin/smart-contract-platform": "latest",
    "@circle-fin/swap-kit": "^1.2.1",
    "@circle-fin/unified-balance-kit": "^1.1.1",
    "@circle-fin/user-controlled-wallets": "latest",
    "@circle-fin/x402-batching": "latest",
    "@langchain/core": "latest",
    "@langchain/openai": "latest",
    "@solana/kit": "^5.5.1",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "latest",
    "@x402/core": "latest",
    "@x402/evm": "latest",
    "deepagents": "latest",
    "dotenv": "latest",
    "ethers": "^6.16.0",
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "openai": "latest",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "viem": "latest",
    "wagmi": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "hardhat": "^3.4.5",
    "supabase": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
