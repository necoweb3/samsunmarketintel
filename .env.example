# Arc
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# Optional keyed Canteen RPC for Agora builders:
# Run `arc-canteen login` then `arc-canteen rpc-url`.
ARC_CANTEEN_RPC_URL=
ARC_TESTNET_CHAIN_ID=5042002
ARC_TESTNET_EXPLORER=https://testnet.arcscan.app
ARC_TESTNET_AGENT_WALLET_ADDRESS=

# Circle CLI / Agent Stack
# Do not commit real credentials. Use `circle wallet login <email> --type agent`
# for local CLI auth, and keep API keys in your local .env only.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_AGENT_WALLET_ADDRESS=
CIRCLE_MAINNET_AGENT_WALLET_ADDRESS=
CIRCLE_BLOCKCHAIN=ARC-TESTNET
CIRCLE_GATEWAY_CHAIN=MATIC

# Contract deployment / receipts
# Keep real private keys only in local .env. Do not commit them.
DEPLOYER_PRIVATE_KEY=
ANALYSIS_RECEIPT_CONTRACT=

# Arc App Kit / Gateway / x402
KIT_KEY=
EVM_PRIVATE_KEY=
BUYER_ADDRESS=
BUYER_PRIVATE_KEY=
SELLER_ADDRESS=
SELLER_PRIVATE_KEY=

# Supabase, if the final app uses realtime dashboards or persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App / AI provider keys, if the final idea needs them.
PRIMARY_MODEL_ID=openrouter/google/gemini-3.1-pro-preview-customtools
PRIMARY_MODEL_PROVIDER=openrouter
PRIMARY_MODEL_BASE_URL=
PRIMARY_MODEL_MAX_OUTPUT_TOKENS=8192
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Sentient / research-agent providers
FIREWORKS_API_KEY=
MODEL_API_KEY=
SERPER_API_KEY=
SEARXNG_INSTANCE_URL=
SEARXNG_API_KEY=
JINA_API_KEY=
TAVILY_API_KEY=
HUGGINGFACE_API_KEY=
OPENDEEPSEARCH_SEARCH_PROVIDER=serper
OPENDEEPSEARCH_RERANKER=jina
OPENDEEPSEARCH_MODE=pro
OPENDEEPSEARCH_INFINITY_ENDPOINT=
LITELLM_MODEL_ID=openrouter/google/gemini-3.1-pro-preview-customtools
LITELLM_SEARCH_MODEL_ID=openrouter/google/gemini-3.1-pro-preview-customtools
LITELLM_ORCHESTRATOR_MODEL_ID=openrouter/google/gemini-3.1-pro-preview-customtools
LITELLM_EVAL_MODEL_ID=gpt-4o-mini

# Public-facing demo budget panel.
# Values are read live; no synthetic credit counters are shown.
CIRCLE_WALLET_BALANCE_CHAIN=BASE
